# Copy this file to ".env.local" and fill in the values. NEVER commit .env.local or share these values.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Secret! Server only. Never put this in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Your website address (no trailing slash) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Payments (leave EMPTY until you have a Razorpay account; payments stay disabled) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email (leave EMPTY until you have a Resend account; downloads still work on the website) ---
RESEND_API_KEY=
EMAIL_FROM=
